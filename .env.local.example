# JK Realty Luxury Platform - Environment Variables
# Copy this file to .env.local to configure your custom credentials

# Google OAuth 2.0 / Google Identity Services
# Obtain your Client ID from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (Web Application)
# 2. Add Authorized JavaScript origins: http://localhost:3000, http://127.0.0.1:3000 (and your production domain)
# 3. Add Authorized redirect URIs: http://localhost:3000, http://localhost:3000/login
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# JK Realty Platform API Key
NEXT_PUBLIC_JKREAL_API_KEY=JKREAL-d320-f37a-e324-8f791c8ce691
JKREAL_API_KEY=JKREAL-d320-f37a-e324-8f791c8ce691

# Optional Backend Configuration
PORT=3000
MONGODB_URI=
